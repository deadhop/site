---
import Base from '../layouts/Base.astro';
import SiteNav from '../components/SiteNav.astro';
import Shot from '../components/Shot.astro';
import Tour from '../components/Tour.astro';
import { benefits, components, docLinks, limits, needs, paths, pricing, principles, product, steps, system } from '../content';
import { products, repos, repoUrl, GITHUB } from '../products';
import { faq, landingJsonLd } from '../seo';
import { at } from '../paths';

const link = (href: string) => (href.startsWith('#') ? href : at(href));
---

<Base
  title={product.title}
  description={product.description}
  path="/"
  markdown="/index.md"
  jsonLd={landingJsonLd(Astro.site!)}
>
  <SiteNav current="payments" />

  <main id="content">
    <section class="intro home-hero" aria-labelledby="hero-title">
      <div class="intro__copy">
        <p class="stamp">ports open at home: 0</p>
        <h1 id="hero-title">{product.headline}</h1>
        <p class="motto-sub">{product.pitch}</p>
        <p class="actions">
          <a class="button button--primary" href={at('/docs/install.html')}>Accept payments</a>
          <a class="button" href="#tour">Take the tour</a>
        </p>
      </div>
      <figure class="system" aria-labelledby="system-cap">
        <div class="system__map">
          <div class="system__side">
            <p class="system__zone">At home</p>
            <ul>
              {system.home.map((n) => <li><a class:list={['system__node', { 'system__node--main': n.main }]} href={link(n.href)}>{n.label}</a></li>)}
            </ul>
          </div>
          <div class="system__wires" aria-hidden="true"><span></span><span></span><span></span></div>
          <div class="system__side">
            <p class="system__zone">In public</p>
            <ul>
              {system.public.map((n) => <li><a class:list={['system__node', { 'system__node--big': n.main }]} href={link(n.href)}>{n.label}</a></li>)}
            </ul>
          </div>
        </div>
        <figcaption id="system-cap">{system.caption} <a href="#parts">All four parts</a></figcaption>
      </figure>
    </section>

    <section class="band band--flush" aria-label="What every part shares">
      <ul class="rules">
        {
          principles.map((p, i) => (
            <li>
              <span class="rules__n">0{i + 1}</span>
              <h2 class="rules__title">{p.title}</h2>
              <p>{p.body}</p>
            </li>
          ))
        }
      </ul>
    </section>

    <section id="tour" class="band" aria-labelledby="tour-title">
      <p class="kicker">The tour</p>
      <h2 id="tour-title">Every screen, before you install</h2>
      <p class="band__lede">Pick a part, then a screen. The numbered dots say what you are looking at. Screens come from a test chain (regtest), not a live shop.</p>
      <Tour />
    </section>

    <section id="start" class="band" aria-labelledby="start-title">
      <p class="kicker">Where do you start?</p>
      <h2 id="start-title">Pick what you came for</h2>
      <ul class="paths">
        {
          paths.map((p) => (
            <li>
              <a href={at(p.href)}>
                <span class="paths__kind">{p.kind}</span>
                <span class="paths__title">{p.title}</span>
                <span class="paths__body">{p.body}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <div class="stage" id="how">
      <div class="stage__copy">
        <section id="story" aria-labelledby="story-title">
          <header class="story__head">
            <p class="kicker">How a payment travels</p>
            <h2 id="story-title">No open port, at any step</h2>
          </header>
          {
            steps.map((s) => (
              <article class="step" id={s.id} aria-labelledby={`${s.id}-title`}>
                <p class="kicker">{s.kicker}</p>
                <h3 id={`${s.id}-title`}>{s.title}</h3>
                <p>{s.body}</p>
              </article>
            ))
          }
        </section>
      </div>
      <div class="stage__visual" aria-hidden="true">
        <canvas id="scene"></canvas>
      </div>
    </div>

    <section id="parts" class="band" aria-labelledby="parts-title">
      <p class="kicker">The parts</p>
      <h2 id="parts-title">Start with payments. Add what you need.</h2>
      <p class="band__lede">Each part is its own repository and its own binary. They share the rules above, not a server.</p>
      <ul class="tools">
        {
          products.map((p) => (
            <li>
              <a class:list={['tools__card', { 'tools__card--main': p.id === 'payments' }]} href={p.id === 'payments' ? at('/docs/install.html') : p.href}>
                <span class="tools__stamp">{p.stamp}</span>
                <span class="tools__name">{p.label}</span>
                <span class="tools__body">{p.blurb}</span>
                <span class="tools__repo">{p.source.map((r) => `deadhop/${r}`).join(' · ')}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <section id="security" class="band" aria-labelledby="security-title">
      <h2 id="security-title" data-reveal>Security benefits</h2>
      <ul class="grid" data-stagger>
        {
          benefits.map((b) => (
            <li>
              <h3>{b.title}</h3>
              <p>{b.body}</p>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="band band--narrow" aria-labelledby="limits-title">
      <h2 id="limits-title" data-reveal>What it does not protect against</h2>
      <ul class="plain" data-stagger>{limits.map((l) => <li>{l}</li>)}</ul>
      <p><a href={at('/docs/security.html')}>Full security analysis</a></p>
    </section>

    <section class="band" aria-labelledby="run-title">
      <h2 id="run-title" data-reveal>What you run</h2>
      <ul class="parts" data-stagger>
        {
          components.map((c) => (
            <li>
              <h3>{c.name}</h3>
              <p>{c.body}</p>
            </li>
          ))
        }
      </ul>
      <p class="price" id="pricing"><strong>Price:</strong> {pricing}</p>
    </section>

    <section class="band band--narrow" aria-labelledby="faq-title">
      <h2 id="faq-title" data-reveal>Questions</h2>
      <dl class="faq" data-stagger>
        {
          faq.map((f) => (
            <div>
              <dt>{f.q}</dt>
              <dd>{f.a}</dd>
            </div>
          ))
        }
      </dl>
    </section>

    <section id="source" class="band" aria-labelledby="source-title">
      <p class="kicker">Source</p>
      <h2 id="source-title">Read every line</h2>
      <p class="band__lede">Eight public repositories under the MIT license. The payment service is tested to 100% line coverage, and end to end on regtest.</p>
      <ul class="repos">
        {
          repos.map((r) => (
            <li>
              <a href={repoUrl(r.name)} rel="noopener">deadhop/{r.name}</a>
              <p>{r.body}</p>
            </li>
          ))
        }
      </ul>
    </section>

    <section id="install" class="band" aria-labelledby="install-title">
      <div class="install">
        <div>
          <p class="kicker">Install</p>
          <h2 id="install-title">Run it next to your node</h2>
          <ul class="install__needs">{needs.map((n) => <li>{n}</li>)}</ul>
        </div>
        <div class="install__go">
          <pre><code>git clone https://github.com/deadhop/stack{'\n'}cd stack</code></pre>
          <p class="actions">
            <a class="button button--primary" href={at('/docs/install.html')}>Choose a setup</a>
            <a class="button" href={at('/docs/quickstart.html')}>Try it on regtest</a>
          </p>
        </div>
      </div>
    </section>

    <section class="band" aria-labelledby="docs-title">
      <h2 id="docs-title" data-reveal>Documentation</h2>
      <ul class="cards" data-stagger>
        {
          docLinks.map((d) => (
            <li>
              <a href={at(d.href)}>
                <span class="cards__kind">{d.kind}</span>
                <span class="cards__title">{d.title}</span>
                <span class="cards__body">{d.body}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>
  </main>

  <footer class="foot">
    <p>deadhop 0.1.0</p>
    <nav aria-label="Footer">
      <ul>
        {products.map((p) => <li><a href={p.href}>{p.label}</a></li>)}
        <li><a href={at('/docs/')}>Documentation</a></li>
        <li><a href={GITHUB} rel="noopener">GitHub</a></li>
        <li><a href={at('/index.md')}>This page as Markdown</a></li>
        <li><a href={at('/llms.txt')}>llms.txt</a></li>
      </ul>
    </nav>
  </footer>

  <script>
    import '../scripts/boot';
  </script>
</Base>
