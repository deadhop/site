---
import Base from '../layouts/Base.astro';
import SiteNav from '../components/SiteNav.astro';
import Shot from '../components/Shot.astro';
import { benefits, components, docLinks, limits, needs, paths, pricing, product, shots, steps } from '../content';
import { products } from '../products';
import { faq, landingJsonLd } from '../seo';
import { at } from '../paths';

const tools = products.filter((p) => p.id !== 'payments');
const toolShots: Record<string, { src: string; width: number; height: number; alt: string } | null> = {
  lnaddr: { src: '/shots/lnaddr-overview.webp', width: 1600, height: 938, alt: 'The lnaddr gateway admin: nodes, latency and the Lightning addresses it serves.' },
  relay: { src: '/shots/relay-operator.webp', width: 1600, height: 938, alt: 'The relay operator page: connections, events and a card per network (clearnet, Tor, I2P, FIPS).' },
  wallet: null,
};
---

<Base
  title={product.title}
  description={product.description}
  path="/"
  markdown="/index.md"
  jsonLd={landingJsonLd(Astro.site!)}
>
  <SiteNav current="payments" />

  <main id="content">
    <section class="intro" aria-labelledby="hero-title">
      <div class="intro__copy">
        <p class="stamp">ports open: 0</p>
        <h1 id="hero-title">{product.motto.split(/(?<=\.)\s+/).map((line) => <span class="line">{line}</span>)}</h1>
        <p class="motto-sub">{product.tagline}</p>
        <p class="lede">{product.summary}</p>
        <p class="actions">
          <a class="button button--primary" href={at('/docs/install.html')}>Install it</a>
          <a class="button" href="#product">See what you get</a>
        </p>
        <p class="fine">Self-hosted · free · MIT · runs next to your own bitcoin node</p>
      </div>
      <Shot class="intro__shot" eager {...shots.hero} />
    </section>

    <section id="start" class="band" aria-labelledby="start-title">
      <p class="kicker">Where do you start?</p>
      <h2 id="start-title">Pick what you came for</h2>
      <ul class="paths">
        {
          paths.map((p) => (
            <li>
              <a href={at(p.href)}>
                <span class="paths__kind">{p.kind}</span>
                <span class="paths__title">{p.title}</span>
                <span class="paths__body">{p.body}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <section id="product" class="band" aria-labelledby="product-title">
      <p class="kicker">What you get</p>
      <h2 id="product-title">A checkout for your customers, a dashboard for you</h2>
      <p class="band__lede">
        The dashboard is a static page. It reaches the service through Nostr relays like any customer does, so it can be hosted anywhere and the service still opens no port. Sign in with your Nostr key; there are no accounts.
      </p>
      <p class="fine">Screenshots from a test chain (regtest), not a live shop.</p>
      <div class="gallery">
        {shots.gallery.map((s) => <Shot {...s} />)}
      </div>
    </section>

    <div class="stage">
      <div class="stage__copy">
        <section id="story" aria-labelledby="story-title">
          <header class="story__head">
            <p class="kicker">How a payment travels</p>
            <h2 id="story-title">No open port, at any step</h2>
          </header>
          {
            steps.map((s) => (
              <article class="step" id={s.id} aria-labelledby={`${s.id}-title`}>
                <p class="kicker">{s.kicker}</p>
                <h3 id={`${s.id}-title`}>{s.title}</h3>
                <p>{s.body}</p>
              </article>
            ))
          }
        </section>
      </div>
      <div class="stage__visual" aria-hidden="true">
        <canvas id="scene"></canvas>
      </div>
    </div>

    <section id="tools" class="band" aria-labelledby="tools-title">
      <p class="kicker">Tools built the same way</p>
      <h2 id="tools-title">One job each, built the same way</h2>
      <ul class="tools">
        {
          tools.map((t) => (
            <li>
              <a class="tools__card" href={t.href}>
                {toolShots[t.id] ? (
                  <img src={at(toolShots[t.id]!.src)} alt={toolShots[t.id]!.alt} width={toolShots[t.id]!.width} height={toolShots[t.id]!.height} loading="lazy" decoding="async" />
                ) : (
                  <pre class="tools__term" aria-label="The sweeper's log after a sweep"><code>sweeping by send once 60000 sat are confirmed{'\n'}send: moved 96409 sat of 100000 to bcrt1qkh5n…5ah2 in 7205…fd9b</code></pre>
                )}
                <span class="tools__name">{t.label}</span>
                <span class="tools__body">{t.blurb}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <section id="security" class="band" aria-labelledby="security-title">
      <h2 id="security-title" data-reveal>Security benefits</h2>
      <ul class="grid" data-stagger>
        {
          benefits.map((b) => (
            <li>
              <h3>{b.title}</h3>
              <p>{b.body}</p>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="band band--narrow" aria-labelledby="limits-title">
      <h2 id="limits-title" data-reveal>What it does not protect against</h2>
      <ul class="plain" data-stagger>{limits.map((l) => <li>{l}</li>)}</ul>
      <p><a href={at('/docs/security.html')}>Full security analysis</a></p>
    </section>

    <section class="band" aria-labelledby="parts-title">
      <h2 id="parts-title" data-reveal>What you run</h2>
      <ul class="parts" data-stagger>
        {
          components.map((c) => (
            <li>
              <h3>{c.name}</h3>
              <p>{c.body}</p>
            </li>
          ))
        }
      </ul>
      <p class="price" id="pricing"><strong>Price:</strong> {pricing}</p>
    </section>

    <section class="band band--narrow" aria-labelledby="faq-title">
      <h2 id="faq-title" data-reveal>Questions</h2>
      <dl class="faq" data-stagger>
        {
          faq.map((f) => (
            <div>
              <dt>{f.q}</dt>
              <dd>{f.a}</dd>
            </div>
          ))
        }
      </dl>
    </section>

    <section id="install" class="band" aria-labelledby="install-title">
      <div class="install">
        <div>
          <p class="kicker">Install</p>
          <h2 id="install-title">Run it next to your node</h2>
          <ul class="install__needs">{needs.map((n) => <li>{n}</li>)}</ul>
        </div>
        <div class="install__go">
          <pre><code>git clone https://github.com/sandwichfarm/deadhop{'\n'}cd deadhop</code></pre>
          <p class="actions">
            <a class="button button--primary" href={at('/docs/install.html')}>Choose a setup</a>
            <a class="button" href={at('/docs/quickstart.html')}>Try it on regtest</a>
          </p>
        </div>
      </div>
    </section>

    <section class="band" aria-labelledby="docs-title">
      <h2 id="docs-title" data-reveal>Documentation</h2>
      <ul class="cards" data-stagger>
        {
          docLinks.map((d) => (
            <li>
              <a href={at(d.href)}>
                <span class="cards__kind">{d.kind}</span>
                <span class="cards__title">{d.title}</span>
                <span class="cards__body">{d.body}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>
  </main>

  <footer class="foot">
    <p>deadhop 0.1.0</p>
    <nav aria-label="Footer">
      <ul>
        {products.map((p) => <li><a href={p.href}>{p.label}</a></li>)}
        <li><a href={at('/docs/')}>Documentation</a></li>
        <li><a href={at('/index.md')}>This page as Markdown</a></li>
        <li><a href={at('/llms.txt')}>llms.txt</a></li>
      </ul>
    </nav>
  </footer>

  <script>
    import '../scripts/boot';
  </script>
</Base>
