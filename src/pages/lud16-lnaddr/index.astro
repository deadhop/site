---
import ToolPage from '../../components/ToolPage.astro';
import { lnaddr } from '../../lnaddr/content';
import { at } from '../../paths';

const url = new URL(at('/lud16-lnaddr/'), Astro.site!).href;
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: 'deadhop lnaddr',
    url,
    description: lnaddr.description,
    applicationCategory: 'FinanceApplication',
    operatingSystem: 'Linux',
    softwareVersion: '0.1.0',
    programmingLanguage: 'Rust',
    featureList: lnaddr.points.map((p) => p.title),
  },
];
---

<ToolPage tool={lnaddr} jsonLd={jsonLd}>
  <Fragment slot="route">
    <svg viewBox="0 0 1000 170" role="img" aria-label="wallet to gateway over https, gateway to node over Nostr relays, node to Lightning backend">
          <line class="wire" x1="70" y1="70" x2="330" y2="70" stroke-width="2"></line>
          <text x="200" y="56" text-anchor="middle">https</text>
          <path class="hop" d="M392 66 C 470 -6, 560 -6, 630 60" fill="none" stroke-width="3" stroke-linecap="round" stroke-dasharray="7 9"></path>
          <path class="hop" d="M640 60 C 710 -6, 800 -6, 868 66" fill="none" stroke-width="3" stroke-linecap="round" stroke-dasharray="7 9"></path>
          <text x="635" y="96" text-anchor="middle">relays · encrypted · outbound only</text>
          <circle cx="60" cy="70" r="11" fill="currentColor"></circle>
          <rect x="330" y="46" width="62" height="48" rx="4" fill="none" stroke="currentColor" stroke-width="2.5"></rect>
          <path d="M868 52 H888 V58 a3 3 0 0 0 3 3 H899 a3 3 0 0 0 3 -3 V52 H922 V92 a4 4 0 0 1 -4 4 H872 a4 4 0 0 1 -4 -4 Z" fill="currentColor"></path>
          <text class="name" x="60" y="132" text-anchor="middle">wallet</text>
          <text class="name" x="361" y="132" text-anchor="middle">gateway</text>
          <text x="361" y="152" text-anchor="middle">public host</text>
          <text class="name" x="895" y="132" text-anchor="middle">your node</text>
          <text x="895" y="152" text-anchor="middle">no open port</text>
        </svg>
  </Fragment>
</ToolPage>
