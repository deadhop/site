---
// Layout for /lud16-lnaddr/: its own stylesheet, the same head rules as the
// rest of the site (CSP, canonical, Markdown twin, Open Graph, JSON-LD).
import '../styles/lnaddr.css';
import { at } from '../paths';

interface Props {
  title: string;
  description: string;
  path: string;
  markdown: string;
  jsonLd: unknown[];
}

const { title, description, path, markdown, jsonLd } = Astro.props;
const site = Astro.site!;
const canonical = new URL(at(path), site).href;
const ogImage = new URL(at('/og.png'), site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      http-equiv="Content-Security-Policy"
      content="default-src 'none'; style-src 'self'; img-src 'self' data:; font-src 'self'; base-uri 'none'; form-action 'none'"
    />
    <meta name="referrer" content="no-referrer" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="text/markdown" href={at(markdown)} title="Markdown version" />
    <link rel="icon" href={at('/favicon.svg')} type="image/svg+xml" />
    <meta name="color-scheme" content="dark light" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="deadhop" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    {jsonLd.map((data) => <script type="application/ld+json" set:html={JSON.stringify(data).replace(/</g, '\\u003c')} />)}
  </head>
  <body>
    <a class="ln-skip" href="#content">Skip to content</a>
    <slot />
  </body>
</html>
