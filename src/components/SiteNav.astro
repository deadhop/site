---
// The header on every page: the brand, the sections of the home page, the
// docs, the source and the way to install whatever page you are on. The parts
// are not in it: the home page shows them, and each part's page carries a
// parts bar under the header to move between them.
import '../styles/nav.css';
import { at } from '../paths';
import { GITHUB, product, products, repoUrl, type ProductId } from '../products';

interface Props {
  current: ProductId;
}
const { current } = Astro.props;
const here = product(current);
const home = current === 'payments';
// On the home page the sections are anchors; elsewhere they lead back to it.
const section = (id: string) => (home ? `#${id}` : at(`/#${id}`));
---

<header class="nav">
  <div class="nav__in">
    <a class="nav__brand" href={at('/')} aria-label="deadhop home">
      <svg viewBox="0 0 32 32" width="26" height="26" aria-hidden="true"
        ><circle cx="4.6" cy="20" r="3.1" fill="currentColor"></circle><path
          d="M7.4 16.2C10.5 5 20 2.6 24.5 14.8"
          fill="none"
          stroke="currentColor"
          stroke-width="2.8"
          stroke-linecap="round"
          stroke-dasharray="4.2 3.6"></path><path
          d="M18 18.5H22.3V20.2a1 1 0 0 0 1 1H25.7a1 1 0 0 0 1-1V18.5H31V28.5a1.5 1.5 0 0 1-1.5 1.5H19.5A1.5 1.5 0 0 1 18 28.5Z"
          fill="currentColor"></path></svg
      >
      <span>deadhop</span>
    </a>
    <nav class="nav__site" aria-label="Site">
      <ul>
        <li><a href={section('tour')}>Tour</a></li>
        <li><a href={section('how')}>How it works</a></li>
        <li><a href={section('security')}>Security</a></li>
        <li><a href={here.docs}>Docs</a></li>
      </ul>
    </nav>
    <nav class="nav__end" aria-label="Source and install">
      <ul>
        <li>
          <a class="nav__source" href={home ? GITHUB : repoUrl(here.source[0])} rel="noopener">
            <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"
              ><path
                fill="currentColor"
                d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"
              ></path></svg
            >
            <span>Source</span>
          </a>
        </li>
        <li><a class="nav__install" href={here.install}>Install</a></li>
      </ul>
    </nav>
  </div>
  {
    !home && (
      <div class="parts-bar">
        <nav class="parts-bar__in" aria-label="Products">
          <span class="parts-bar__label">Parts</span>
          <ul>
            {products.map((p) => (
              <li>
                <a href={p.href} aria-current={p.id === current ? 'page' : undefined}>
                  {p.label}
                </a>
              </li>
            ))}
          </ul>
          <a class="parts-bar__repo" href={repoUrl(here.source[0])} rel="noopener">
            deadhop/{here.source[0]} ↗
          </a>
        </nav>
      </div>
    )
  }
</header>
